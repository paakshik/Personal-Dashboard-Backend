# Render PostgreSQL external/internal connection string
DATABASE_URL=postgresql://postgres:[REDACTED]@YOUR_SUPABASE_HOST:5432/postgres

# Required application signing secret
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256

# Google OAuth values (needed for Google sign-in/integrations)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-BACKEND.onrender.com/dashboard/auth/google/callback
FRONTEND_URL=https://YOUR-FRONTEND.onrender.com
ALLOWED_ORIGINS=https://YOUR-FRONTEND.onrender.com

# Optional integrations
GEMINI_API_KEY=
TODOIST_TOKEN=
SENTRY_DSN=

# Optional bounded SQLAlchemy pool tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5

# Optional Render Redis connection
REDIS_URL=redis://localhost:6379/0
